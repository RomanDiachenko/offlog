{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "log:default",
    "dialog:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/auto-backups" }, { "path": "$APPDATA/auto-backups/**" }]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "$APPDATA/auto-backups" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "$APPDATA/auto-backups" }]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [{ "path": "$APPDATA/auto-backups/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "$APPDATA/auto-backups/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "$APPDATA/auto-backups/**" }]
    },
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "deny": [
        { "path": "$APPDATA/sync-host*.json" },
        { "path": "$APPDATA/sync-secret*" },
        { "path": "$APPDATA/nyxdb-data*/**" },
        { "path": "$APPLOCALDATA/EBWebView/**" }
      ]
    },
    "updater:default",
    "process:default"
  ]
}
